record lege-ecosystem.observation.jbig2-symbol-mode-is-lossy/1 : observation {
    title "JBIG2 symbol substitution is lossy, and its size win depends on content"
    state verified
    scope [ path "lege-codecs/jbig2enc-rust/**", path "lege-process/**" ]
    statement """
        Symbol substitution does not round-trip bit-exactly, and no configuration makes it do so. On tests/fixtures/test_image1.pbm (956x1557, 185395 ink px) symbol mode changed 175 pixels and produced 13211 bytes against the generic region's 12941 bytes and 0 changed pixels -- lossy AND larger. Enabling refine, text_refine, is_lossless, or disabling auto_thresh left the count at exactly 175 in every combination, so refinement does not close the gap as ISO/IEC 14492 refinement is supposed to. text_symbol_unify() is far lossier at 1215 pixels. The win is real on genuine text: a 4-page scanned paper through the full lege pipeline gave 225527 bytes with symbol mode against 234513 with --no-symbol (3.8% smaller), and a synthetic page of exactly repeated glyphs gave 1027 against 2876. Symbol mode is now the default in Jbig2Config, the lege CLI and the Python wheel; Jbig2Config::generic(), --no-symbol, the option-string 'g' modifier and the GUI's No symbol mode toggle are the bit-exact opt-out. The unclosed refinement gap is the follow-up worth taking: it is what would make symbol mode safe for archival masters.
        """
    observed_at git:645c74324a154bea2d512fc30a9628f47a60229e
    method command
    watches [ "lege-codecs/jbig2enc-rust/src/encode/**" ]
}

record lege-ecosystem.observation.jbig2enc-inert-config-fields/1 : observation {
    title "Three jbig2enc-rust config fields are inert in the encoder"
    state verified
    scope [ path "lege-codecs/jbig2enc-rust/**" ]
    statement """
        Jbig2Config::{dpi, duplicate_line_removal, match_tolerance} do not change encoder output. Measured on a 480x320 glyph page via encode_single_image_with_config: default 2876 bytes, and dpi=600, duplicate_line_removal=false and match_tolerance in {4,7,10} all produced 2876 bytes byte-for-byte. match_tolerance is only read when config.text_refine is set (encode/document.rs:451), and produced identical output (1046 bytes) at every tolerance even with text_refine enabled. By contrast symbol_mode=true works as documented (2876 -> 1027 bytes) and is required for a shared /JBIG2Globals dictionary. Consequence: the jbig2enc Python binding deliberately exposes only symbol_mode, refine and the lossless preset, and rejects the three inert names as unknown options rather than accepting them silently.
        """
    observed_at git:dd69931cda0595bdf08caa422f3966bf484fb47c
    method command
    watches [ "lege-codecs/jbig2enc-rust/src/encode/**" ]
}

record lege-ecosystem.observation.jbig2enc-py-round-trip-verified/1 : observation {
    title "jbig2enc Python binding round-trips pixel-exactly in every mode"
    state verified
    scope [ path "lege-misc/bindings/jbig2enc-py/**" ]
    statement """
        The jbig2enc pyo3 binding encodes and decodes back byte-identical pixels on a 480x320 glyph page in all exercised modes: standalone generic region (2876 B), standalone symbol mode (1027 B), PDF fragment without globals, PDF fragment with a 64-byte shared dictionary, and a three-page document sharing one dictionary. Zero differing pixels in every case, so both encoder modes are lossless at the exposed settings and the multi-page shared-dictionary symbol indices line up. Verified through the installed wheel (jbig2enc-0.5.4-cp311-abi3-manylinux_2_34_x86_64) in a clean virtualenv, 20 pytest tests green; cargo clippy --release clean.
        """
    observed_at git:dd69931cda0595bdf08caa422f3966bf484fb47c
    method command
    watches [ "lege-misc/bindings/jbig2enc-py/**", "lege-codecs/jbig2enc-rust/src/**" ]
}

record lege-ecosystem.observation.ocr-v5-v6-recipe-20260820/1 : observation {
    title "PP-OCRv6 TensorRT improved the recipe-PDF proxy over embedded v5"
    state verified
    scope [ path "lege-document-ocr/**", path "lege-ocr/**" ]
    statement """
        On the two-page D:\to-sort\5-Minute Hummus Recipe - NYT Cooking.pdf at 300 DPI capped to 12 MP and forced OCR, embedded PP-OCRv5/WGPU scored 17.88% CER and 19.16% WER against the pipeline's native text extraction, while PP-OCRv6-tiny/TensorRT scored 12.00% CER and 14.17% WER. The native v6 worker passed detector and recognizer inference after cold engine compilation. A generic Paddle/WGPU v6 model pack passed checksum validation but failed detector construction, so it is not a viable v6 replacement yet.
        """
    observed_at git:3f520cc03211e48adaa77c1da9bc639c53d2d351
    method command
    watches [ "lege-document-ocr/**", "lege-ocr/**", "lege-gpu/**" ]
    derived_from [ @lege-ecosystem.work.ocr-backend-scheduler/4 ]
    verified_by [ @lege-ecosystem.evidence.ocr-v5-v6-recipe-20260820/1 ]
    author "GitHub Uploader"
}

record lege-ecosystem.observation.ppocrv6-wgpu-blockers-resolved-20260822/1 : observation {
    title "PP-OCRv6 on wgpu was blocked by four concrete gaps, all now closed"
    state verified
    scope [ path "lege-gpu/**", path "lege-ocr/**", path "lege-process/scripts/**" ]
    statement """
        The earlier finding that a Paddle/WGPU v6 model pack "failed detector construction" had four independent causes, each now fixed. (1) Stock Paddle exports name the graph input `x`, which match_target in lege-gpu/src/vision/onnx/load.rs bound to the paddle-rotate target's fixed 224x224 contract; the v5 assets had been renamed to pp_det_image/pp_rec_image out of band and that recipe was never committed. (2) lege-gpu had no Erf kernel (v6 builds GELU from it, 13x in det, 10-13x in rec); added as UnaryKind::Erf with an Abramowitz-Stegun 7.1.26 WGSL shader and a matching CPU reference. (3) v6 det uses ConvTranspose 2x2/stride-2 and v6 rec keeps BatchNormalization behind a Squeeze; both are rewritten at prep time, ConvTranspose into Conv1x1+DepthToSpace (exact for kernel==stride, zero pad) and BN into Mul+Add. (4) MaxPool/AveragePool rejected auto_pad!=NOTSET and ignored it during shape inference, so PP-OCRv6's stride-1 SAME_UPPER 2x2 windows shrank the feature map by one pixel and surfaced as a Concat axis-2 mismatch; both now resolve auto_pad exactly as Conv already did. Whole-spatial ReduceMean(axes=[2,3]) is also rewritten to GlobalAveragePool at prep. The v6 small dictionary (18708 glyphs) is a near-superset of v5's 18383 - 35 dropped, 360 added - and repairs v5's Latin-1 coverage, which held only 70 of 192 codepoints in U+00C0..U+017F.
        """
    observed_at git:3f520cc03211e48adaa77c1da9bc639c53d2d351
    method command
    watches [
        "lege-gpu/src/vision/onnx/**",
        "lege-gpu/src/vision/decode/db.rs",
        "lege-ocr/assets/**",
        "lege-process/scripts/prepare_ppocr_models.py"
    ]
    supersedes [ @lege-ecosystem.observation.ocr-v5-v6-recipe-20260820/1 ]
    verified_by [ @lege-ecosystem.evidence.ppocrv6-wgpu-embedded-20260822/1 ]
}

record lege-ecosystem.observation.truetyping-letters-ride-off-their-baseline/1 : observation {
    title "Truetyping letters sit a pixel or two off the baseline, and identical shapes make it obvious"
    state verified
    scope [
        path "lege-process/core/pdf_artifact.rs",
        path "lege-process/encoding/glyphfont.rs"
    ]
    statement """
        In truetyping output, individual letters within a word sit a pixel or two above where they belong — `this` with its `is` riding high, `doomed in any` with the `in` lifted — while the line as a whole is level. The user reported it after the substitution fixes landed, and it is visible on page 500 of the 836-page Gernet run (`~/Downloads/lege-review-2026-09-03/truetyping-vertical-wobble-p500.png`, rendered at 1400 px working height). The effect is amplified by how completely the dictionary deduplicates: every `e` on the page is the same outline, so the only variation left between them is their height, and the eye reads that as letters out of place. JBIG2 symbol mode, which shares the same shapes through the same clustering, does not show it; sym-unify is not the comparison, plain symbol mode is.
        """
    observed_at git:9925fb523be7d23bdf664b1aa66dd9ae44ecc1ee
    method observation
    watches [ "lege-process/encoding/glyphfont.rs", "lege-process/core/pdf_artifact.rs" ]
    claim a-pixel-is-a-tenth-of-a-letter-at-this-height {
        text """
            The snap is one pixel of the *working* raster, so its visual weight depends on the render height: at the 1400 px this book was traced at, body type is about ten pixels, and a pixel is a tenth of the x-height.
            """
    }
    claim jbig2-shares-the-shape-but-not-the-position {
        text """
            JBIG2 symbol mode carries each occurrence's own top-left on the page (`TextRegionSymbolInstance { x, y }`, jbig2enc-rust dictionary.rs:645) beside the shared symbol id, so a shared bitmap costs nothing in placement. Truetyping shares the shape *and* the position: an occurrence is drawn at its prototype's descent, not its own.
            """
    }
    claim the-prototypes-descent-comes-from-one-page {
        text """
            `fix_new_prototype_metrics` fixes a prototype's descent once, as the lower median of its occurrences on the page that created it; every later page is measured against that page's estimate, and nothing revises it.
            """
    }
    claim the-vertical-residual-is-thrown-away-or-turned-into-a-glyph {
        text """
            `GlyphDictionary::process_analysis` replaces an occurrence's measured bottom with its prototype's `descent`: a residual within `RISE_SNAP_PX` (1 px of the working raster) is snapped to zero, and a larger one becomes a *position variant*, a second glyph whose own descent was fixed by its first instance and which then absorbs later occurrences within `VARIANT_JOIN_PX` (also 1 px).
            """
    }
}

record lege-ecosystem.observation.windows-ocr-200-page-benchmark-20260814/1 : observation {
    title "Windows OCR first-pass benchmark on a 200-page scanned book"
    state superseded
    scope [
        path "lege-document-ocr/**",
        path "lege-gpu/**",
        path "lege-ocr/**",
        path "lege-pdf/read/**"
    ]
    statement """
        On the Windows i7-13700H/RTX 4060 host, four Windows Runtime OCR document workers at a 12 MP page cap processed the 200-page sample in 42.161 seconds (4.744 pages/s), versus 184.148 seconds for one document worker and 727.013 seconds for four Paddle/WGPU workers; Windows and Paddle scored 1.14%/4.49% and 1.11%/5.88% CER/WER proxies respectively against the source OCR layer.
        """
    observed_at git:3679ebb163b77cd9960b5cb138af642050341c58
    method command
    watches [ "lege-document-ocr/**", "lege-ocr/**", "lege-gpu/**", "lege-pdf/read/**" ]
    derived_from [ @lege-ecosystem.work.ocr-backend-scheduler/4 ]
    verified_by [ @lege-ecosystem.evidence.windows-ocr-200-page-benchmark-20260814/1 ]
    source {
        kind internal
        role evidence
        path "lege-document-ocr/WINDOWS-BENCHMARK.md"
        use """
            Records the host, corpus, commands, timings, proxy accuracy, caveats, and first-pass optimization priorities.
            """
    }
}

record lege-ecosystem.observation.windows-ocr-200-page-benchmark-20260814/2 : observation {
    title "Windows OCR first-pass benchmark on a 200-page scanned book"
    state verified
    scope [
        path "lege-document-ocr/**",
        path "lege-gpu/**",
        path "lege-ocr/**",
        path "lege-pdf/read/**"
    ]
    statement """
        On the Windows i7-13700H/RTX 4060 host, four Windows Runtime OCR document workers at a 12 MP page cap processed the 200-page sample in 42.161 seconds (4.744 pages/s), versus 184.148 seconds for one document worker and 727.013 seconds for four Paddle/WGPU workers. The integrated PP-OCRv6-tiny TensorRT path later processed the 10-page sample in 2.731 seconds during post-commit validation; conservative spacing correction improved normalized WER from 9.934% to 9.335% and CER from 2.024% to 1.964%, with a warm 2.225-second corrected run versus 2.134 seconds without correction.
        """
    observed_at git:1d6defbf53ad70aa869a547c7c58aeb61141176f
    method command
    watches [ "lege-document-ocr/**", "lege-ocr/**", "lege-gpu/**", "lege-pdf/read/**" ]
    derived_from [ @lege-ecosystem.work.ocr-backend-scheduler/4 ]
    supersedes [ @lege-ecosystem.observation.windows-ocr-200-page-benchmark-20260814/1 ]
    verified_by [ @lege-ecosystem.evidence.windows-ocr-200-page-benchmark-20260814/1 ]
}
