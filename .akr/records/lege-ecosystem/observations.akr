record lege-ecosystem.observation.windows-ocr-200-page-benchmark-20260814/1 : observation {
    title "Windows OCR first-pass benchmark on a 200-page scanned book"
    state superseded
    scope [
        path "lege-document-ocr/**",
        path "lege-gpu/**",
        path "lege-ocr/**",
        path "lege-pdf/read/**"
    ]
    statement """
        On the Windows i7-13700H/RTX 4060 host, four Windows Runtime OCR document workers at a 12 MP page cap processed the 200-page sample in 42.161 seconds (4.744 pages/s), versus 184.148 seconds for one document worker and 727.013 seconds for four Paddle/WGPU workers; Windows and Paddle scored 1.14%/4.49% and 1.11%/5.88% CER/WER proxies respectively against the source OCR layer.
        """
    observed_at git:3679ebb163b77cd9960b5cb138af642050341c58
    method command
    watches [ "lege-document-ocr/**", "lege-ocr/**", "lege-gpu/**", "lege-pdf/read/**" ]
    derived_from [ @lege-ecosystem.work.ocr-backend-scheduler/4 ]
    verified_by [ @lege-ecosystem.evidence.windows-ocr-200-page-benchmark-20260814/1 ]
    source {
        kind internal
        role evidence
        path "lege-document-ocr/WINDOWS-BENCHMARK.md"
        use """
            Records the host, corpus, commands, timings, proxy accuracy, caveats, and first-pass optimization priorities.
            """
    }
}

record lege-ecosystem.observation.windows-ocr-200-page-benchmark-20260814/2 : observation {
    title "Windows OCR first-pass benchmark on a 200-page scanned book"
    state verified
    scope [
        path "lege-document-ocr/**",
        path "lege-gpu/**",
        path "lege-ocr/**",
        path "lege-pdf/read/**"
    ]
    statement """
        On the Windows i7-13700H/RTX 4060 host, four Windows Runtime OCR document workers at a 12 MP page cap processed the 200-page sample in 42.161 seconds (4.744 pages/s), versus 184.148 seconds for one document worker and 727.013 seconds for four Paddle/WGPU workers. The integrated PP-OCRv6-tiny TensorRT path later processed the 10-page sample in 2.731 seconds during post-commit validation; conservative spacing correction improved normalized WER from 9.934% to 9.335% and CER from 2.024% to 1.964%, with a warm 2.225-second corrected run versus 2.134 seconds without correction.
        """
    observed_at git:1d6defbf53ad70aa869a547c7c58aeb61141176f
    method command
    watches [ "lege-document-ocr/**", "lege-ocr/**", "lege-gpu/**", "lege-pdf/read/**" ]
    derived_from [ @lege-ecosystem.work.ocr-backend-scheduler/4 ]
    supersedes [ @lege-ecosystem.observation.windows-ocr-200-page-benchmark-20260814/1 ]
    verified_by [ @lege-ecosystem.evidence.windows-ocr-200-page-benchmark-20260814/1 ]
}
