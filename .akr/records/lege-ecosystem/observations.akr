project lege-ecosystem

record lege-ecosystem.encode-quality.headsup-measurement-2026-08-11/1 : observation {
    title "jp2lam lossy quality trails JPEG XL/BPG and collapses with resolution (codec-headsup, 2026-08-11)"
    state verified
    scope [
        path "lege-codecs/jp2lam/src/dwt/pcrd.rs",
        path "lege-codecs/jp2lam/src/encode/**",
        path "lege-codecs/jp2lam/src/plan/**"
    ]
    statement """
        A standalone Rust head-to-head (codec-headsup, at /mnt/Samsung980_1TB/Rust-projects/codec-headsup) compared jp2lam JPEG 2000, libjxl JPEG XL, and bpg-rs BPG on phone photos (a balanced 100x ~50MP + 100x ~12MP sample), grading DECODED RGB with the butteraugli and ssimulacra2 crates. At a fixed operating point (JXL cjxl -d 1.0 -e 9; BPG best qp12; jp2lam RateControl::Quality(98) via Preset::PhotoHigh), across the first 35 completed images jp2lam q98 reached a mean butteraugli of ~4.2 (median ~3.8) versus ~1.3 for JPEG XL and ~1.4 for BPG, while being LARGER than JPEG XL in 34/35 cases (mean size jp2/bpg 0.87, jxl/bpg 0.60, jxl/jp2 0.73).

        Quality was strongly resolution-dependent at the SAME quality setting: jp2lam q98 achieved butteraugli ~2 on ~12MP images but ~5-10 on ~50MP images (e.g. 20260105_095336, 50MP: jp2 butteraugli 10.2 at 4.93MB vs jxl butteraugli 1.31 at 4.22MB), and mean ssimulacra2 fell from ~88 on 12MP to ~82 on 50MP. A fixed jp2lam quality therefore does not hold a fixed perceptual quality, and jp2lam's quality-per-byte on this photographic set is below both next-gen codecs. Separately, decoding a 50MP JP2 exceeded the default DecodeLimits working-set cap (estimated ~3.0 GB vs the 1 GiB default), aborting decode until the limit was raised.
        """
    observed_at git:7cf7bac3cee07919b12bdf545661ef7ee502bebb
    method observation
}

record lege-ecosystem.observation.bpg-variance-separates-line-art/1 : observation {
    title "bpg-rs variance features separate line art from photos"
    state superseded
    statement """
        The bpg-rs still265 preanalysis (RegionClass / classify in crates/still265/src/preanalysis.rs) distinguishes line art from photographs using per-32x32-cell luma variance, Sobel edge density, 4-bin gradient orientation entropy, and chroma activity. The measurement corpus is gone; the surviving result is those thresholds (FLAT_VAR=12, TEXTURE_VAR=64, TEXT_EDGE_Q8=64, AXIS_ALIGNED_Q8=160, LOW_ENTROPY_Q8=110). A page-global luma-histogram bimodality test cannot make the same cut: it also fires on maps and engravings, which is why 2a86e46 removed region_is_line_art from the overlay retain.
        """
    observed_at git:3679ebb163b77cd9960b5cb138af642050341c58
    method manual
    author "GitHub Uploader"
}

