record lege-ecosystem.observation.bpg-variance-separates-line-art/3 : observation {
    title "bpg-rs variance features separate line art from photos"
    state verified
    statement """
        The bpg-rs still265 32x32 cell features (variance, Sobel, orientation, chroma) plus paper-share and luma mid-band separate line art from colour/filled plates on two real books. Structures.pdf: painting cover and terracotta photo stay overlays (chroma 269 / filled flat 0.16); line-only Paris map, pencil sketch, and bimodal ink maps skip (flat 0.67-0.69 or mid 0.07-0.16). buddhasahibsmenw0000alle_1.pdf: photo cover stays (chroma 485, flat 0.06); interior engravings, sculpture drawings, and plans skip. Cream scan paper plus black ink must not count as a colour plate (gate 80, those pages land at 4-59).
        """
    observed_at git:3679ebb163b77cd9960b5cb138af642050341c58
    method observation
    supersedes [ @lege-ecosystem.observation.bpg-variance-separates-line-art/2 ]
    author "GitHub Uploader"
}

record lege-ecosystem.observation.doclayout-m-underdetects-text-and-images/1 : observation {
    title "DocLayout-M underdetects text and some images"
    state superseded
    statement """
        PP-DocLayout-M on Structures.pdf (Braudel scan) systematically underdetects: whole body paragraphs are omitted (pages 191, 194, 200), captions and run-on last lines are clipped horizontally (pages 195, 198, 200), and image boxes are occasionally tight but never oversized. The default Linux Paddle OCR path (`perform_page_rgb_ocr`) already runs DBNet on the full page and does not crop to DocLayout boxes. DocLayout still drives image overlays/premask, crop/margins, reflow, slow OCR regions, and the Tesseract region path.
        """
    observed_at git:70147b50c31faf7aad4e0eaf056745ccd7cd8e49
    method manual
    watches [
        "lege-process/ocr/fast.rs",
        "lege-process/pipeline/pdf_tokio_pipeline.rs",
        "lege-process/core/layout_correct.rs",
        "lege-process/core/types.rs"
    ]
    review_after 2026-11-13
}

