record lege-ecosystem.evidence.djvu-encode-second-pass-2026-09-04/1 : evidence {
    title "DjVu page encode is 1.3-1.5x faster with bit-identical output"
    state verified
    result pass
    method command
    observed_at git:ca90b1f74165ec5a879dfa84c38aabb55002df4e
    command "interleaved A/B of benchmark binaries built from HEAD and from the change, pinned to one core, best of nine; plus cargo test --features cli"
    summary """
        Second DjVu encode pass: 1600x1200 gradient page 104.4 -> 78.7 ms (1.33x), noise page 127.9 -> 109.7 ms (1.17x), 2480x3508 white page 399.5 -> 264.5 ms (1.51x), full A4 bilevel page 466.1 -> 320.7 ms (1.45x). Output bit-identical across a 64-case matrix of sizes, image kinds, colour/grey and bg_subsample. Independently reproduced by the parent session at 1.30x on the gradient page with identical output bytes. Three ZP-coder micro-variants measured slower and were reverted.
        """
}

record lege-ecosystem.evidence.djvu-iw44-encode-speedup-2026-09-04/1 : evidence {
    title "DjVu IW44 page encode is ~15% faster with unchanged output"
    state verified
    result pass
    method command
    observed_at git:cde509dd110d564cdb99a127c64bbf8805ab2efc
    command "cargo run --release --example benchmark --features simd (baseline and optimized binaries built, copied aside, and run interleaved; best of four each)"
    summary """
        Removing bounds checks and repeated field indexing from the IW44 coder's encode_prepare and encode_buckets cut a 1600x1200 page encode from 88.5 ms to 75.2 ms, about 15%, with bit-identical output (3848 bytes both). Measured by interleaved A/B because the host was running other work and absolute times drifted by more than the effect being measured.
        """
}

