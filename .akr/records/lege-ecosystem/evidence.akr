record lege-ecosystem.evidence.lege-gpu-layout-init-overlap-2026-08-09/1 : evidence {
    title "Fresh-process release profiling on Intel Iris Xe/Vulkan showed median first-engine initialization falling from 93.831 ms to 82.591 ms (-11.98%) and median two-session pool initialization from 97.182 ms to 88.091 ms (-9.36%) when full model decoding/preparation overlaps adapter/device discovery. The constructor still joins both jobs before graph allocation and return; adapter selection, fallback ordering, feature requests, buffer allocation, and eager sibling readiness are unchanged."
    state verified
    result pass
    method observation
    observed_at git:f283e94f66351240c35d6a408ab1c5a1f6641c4b
    artifact ".agent/scratch/lege-gpu-init-benchmark-2026-08-09.md"
    summary """
        Fresh-process release profiling on Intel Iris Xe/Vulkan showed median first-engine initialization falling from 93.831 ms to 82.591 ms (-11.98%) and median two-session pool initialization from 97.182 ms to 88.091 ms (-9.36%) when full model decoding/preparation overlaps adapter/device discovery. The constructor still joins both jobs before graph allocation and return; adapter selection, fallback ordering, feature requests, buffer allocation, and eager sibling readiness are unchanged.
        """
}

