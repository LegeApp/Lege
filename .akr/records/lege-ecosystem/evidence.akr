record lege-ecosystem.evidence.lege-process-about-email-removed-2026-08-09/1 : evidence {
    title "Both shipped About popup implementations now construct only their header when the theme chooser is closed, so no removed-row child or spacing remains. The email field/value is absent from both GUI schemas and both locale files, the scoped search returned no matches, and both locale schema tests passed."
    state verified
    result pass
    method command
    observed_at git:f283e94f66351240c35d6a408ab1c5a1f6641c4b
    command "rg -n -i 'read@legeapp.com|popups.email|\"email\"' lege-process/GUI lege-process/language_service; cargo test -p lege-gui-freya -p lege-music-gui bundled_locales_match_the_gui_schema"
    summary """
        Both shipped About popup implementations now construct only their header when the theme chooser is closed, so no removed-row child or spacing remains. The email field/value is absent from both GUI schemas and both locale files, the scoped search returned no matches, and both locale schema tests passed.
        """
}

