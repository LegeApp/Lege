record lege-ecosystem.evidence.jbig2-generic-default-costs-little-20260906/1 : evidence {
    title "Generic JBIG2 costs 0.6% over sym-unify on an 886-page scan"
    state verified
    scope [ path "lege-process/**" ]
    result pass
    method command
    observed_at git:df6bb8cf45e9ee68a6544bbaf9e9136f6cd171d2
    command """
        lege crusadeswholesto0000lamb_1.pdf --text-format jbig2 [--sym-unify] --output ...
        """
    summary """
        886 pages of a 240-dpi library scan, debug-fast build. Bit-exact generic region: 41 s, 21,322,267 bytes. Symbol substitution with unification: 42 s, 21,200,663 bytes — 0.6% smaller. On the first 41 pages the gap was 1.9% (894,969 against 878,208 bytes), and the plain symbol dictionary landed between the two at 879,231. Truetyping with no binarization flag produced the same output as --grayscale on 6 pages (260,459 against 260,496 bytes), confirming the new implied grayscale.
        """
    derived_from [
        @lege-ecosystem.decision.jbig2-symbol-substitution-is-opt-in,
        @lege-ecosystem.decision.truetyping-renders-in-grayscale-by-default
    ]
    author "GitHub Uploader"
}

