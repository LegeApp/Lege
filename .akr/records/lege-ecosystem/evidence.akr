record lege-ecosystem.encode-quality.evidence.perceptual-pcrd-curve-2026-08-13/1 : evidence {
    title "Size-matched perceptual PCRD curve benchmark"
    state verified
    result pass
    method command
    observed_at git:70147b50c31faf7aad4e0eaf056745ccd7cd8e49
    command "cargo run --release --example perceptual_curve -- test-set 25,50,75,90,98 7; cargo run --release --example perceptual_curve -- .agent/scratch/encode-quality/corpus6-20260812 50,75,90,98; compare against detached 70147b50 CSV baselines"
    artifact "lege-codecs/jp2lam/.agent/scratch/encode-quality/summary-2026-08-12.md"
    summary """
        On the working tree rooted at 70147b50, decoded-RGB Butteraugli and SSIMULACRA2 comparisons preserved mean output size within 0.0603% at q25 and 0.0016% at q50/q75/q90/q98; q25/q50/q75 improved both perceptual metrics on the seven-photo mean, q50/q75 improved both on the mixed-resolution six-photo mean, q90 improved the mixed-resolution mean, and q98 was byte-identical.
        """
}

