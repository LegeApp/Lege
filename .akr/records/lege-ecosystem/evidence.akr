record lege-ecosystem.evidence.rtx4060-vulkan-visibility/1 : evidence {
    title "RTX 4060 exists but is not Vulkan-visible in this environment"
    state verified
    result inconclusive
    method command
    observed_at git:7cf7bac3cee07919b12bdf545661ef7ee502bebb
    command "nvidia-smi -L; env -u WGPU_ADAPTER_NAME LEGE_TEST_GPU_SELECTION=1 cargo test -p lege-gpu --features layout-detection shared_context_prefers_discrete_when_available --lib -- --nocapture"
    summary """
        nvidia-smi saw the RTX 4060, while wgpu enumerated only Intel Iris Xe and llvmpipe. Vulkan loader diagnostics showed the NVIDIA ICD could not load libGLX_nvidia.so.0 because only an i386 library was installed.
        """
}

