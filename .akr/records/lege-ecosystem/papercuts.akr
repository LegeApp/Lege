record lege-ecosystem.papercut.healing-an-inherited-akr-t023-on-an-evidence/1 : papercut {
    title "Healing an inherited AKR-T023 on an evidence record that another record…"
    state verified
    statement """
        Healing an inherited AKR-T023 on an evidence record that another record pins by revision deadlocks: revising the evidence introduces AKR-L021 on the referrer, and the referrer cannot be repointed first because the target revision does not exist yet. The escape is a three-write dance (drop the reference, revise the evidence, re-add it at the new revision); a single write that repoints referrers, or tolerating a superseded pin inside one transaction, would remove it.
        """
    observed_at git:f29d57ab3f5ca3b7da2d54aa1044925852bf3b0b
    about "akr"
    author "claude-opus"
    created_at 2026-08-25
}

