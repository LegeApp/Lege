    about "akr"
    author "grok"
    created_at 2026-08-13
}

record lege-ecosystem.papercut.akr-revise-from-body-on-a-completed-work-record/1 : papercut {
    title "`akr revise --from <body>` on a completed work record silently reset it…"
    state verified
    statement """
        `akr revise --from <body>` on a completed work record silently reset it to `proposed` even though the supplied body said `state completed`, and the only signal was the generated commit message reading 'completed -> proposed'. Because a proposed record is exempt from V-020, the AKR-R022 errors I was repairing vanished for the wrong reason. Either honour the state in --from or refuse a body whose state contradicts the lifecycle step.
        """
    observed_at git:f29d57ab3f5ca3b7da2d54aa1044925852bf3b0b
    about "akr"
    author "claude-opus"
    created_at 2026-08-25
}

