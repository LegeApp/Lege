record lege-ecosystem.papercut.akr-papercut-collate-defaults-to-scanning/1 : papercut {
    title "akr papercut collate defaults to scanning sibling workspaces of the…"
    state verified
    statement """
        akr papercut collate defaults to scanning sibling workspaces of the current root, so running it in Lege-ecosystem looks like it should list this folder's cuts but instead walks Rust-projects/*. Local review is akr view papercuts; collate is an aggregator. Defaulting --projects to the current workspace (and requiring --projects .. to scan sisters) would match the obvious meaning.
        """
    observed_at git:70147b50c31faf7aad4e0eaf056745ccd7cd8e49
    about "akr"
    author "grok"
    created_at 2026-08-13
}

