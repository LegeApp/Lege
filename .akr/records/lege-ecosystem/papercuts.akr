record lege-ecosystem.papercut.a-single-cargo-build-selecting-lege-and-lege/1 : papercut {
    title "A single Cargo build selecting `lege` and `lege-gui-freya` with bin…"
    state superseded
    statement """
        A single Cargo build selecting `lege` and `lege-gui-freya` with bin filters still selected the same-named `lege-gui` target from both packages, producing an output collision. The standard alias must build Freya through the existing integrated `lege --features freya` target (or use an xtask), because Cargo bin filters are not package-scoped.
        """
    observed_at git:5111194256cf31247e1d5157a120595619554520
    author "codex"
    created_at 2026-08-12
}

record lege-ecosystem.papercut.a-single-cargo-build-selecting-lege-and-lege/2 : papercut {
    title "A single Cargo build selecting `lege` and `lege-gui-freya` with bin…"
    state withdrawn
    statement """
        RESOLVED: .cargo/config.toml documents that Freya is package lege --features freya --bin lege-gui, and must not be combined with package lege-gui in one invocation.
        """
    observed_at git:70147b50c31faf7aad4e0eaf056745ccd7cd8e49
    supersedes [ @lege-ecosystem.papercut.a-single-cargo-build-selecting-lege-and-lege/1 ]
}

