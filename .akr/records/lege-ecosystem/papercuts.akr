record lege-ecosystem.papercut.the-windows-tensorrt-cache-canonicalized/1 : papercut {
    title "The Windows TensorRT cache canonicalized separators and relative paths…"
    state verified
    statement """
        The Windows TensorRT cache canonicalized separators and relative paths but still hashed path casing, so the same ONNX model under `Lege-ecosystem` versus `lege-ecosystem` triggered a duplicate multi-minute engine build. Cache identities are now case-folded on Windows with a display-case compatibility lookup for existing engines.
        """
    observed_at git:3679ebb163b77cd9960b5cb138af642050341c58
    author "codex"
    created_at 2026-08-14
}

