record lege-ecosystem.papercut.cargo-info-symspell-rs-6-8-3-took-85-seconds/1 : papercut {
    title "`cargo info symspell_rs@6.8.3` took 85 seconds because the crates.io…"
    state verified
    statement """
        `cargo info symspell_rs@6.8.3` took 85 seconds because the crates.io download transferred no bytes for 30 seconds and retried before succeeding. Dependency discovery worked, but the transient slow-transfer threshold made a small metadata check look stalled.
        """
    observed_at git:3679ebb163b77cd9960b5cb138af642050341c58
    about "cargo"
    author "codex"
    created_at 2026-08-14
}

record lege-ecosystem.papercut.cargo-test-p-lege-gpu-fails-to-compile-the/1 : papercut {
    title "`cargo test -p lege-gpu` fails to compile the layout_compare example…"
    state verified
    statement """
        `cargo test -p lege-gpu` fails to compile the layout_compare example because it imports LayoutDetector/LayoutDetection, which are behind the layout-detection feature, and the example declares no required-features in lege-gpu/Cargo.toml. Pre-existing; the test suite itself is clean under --features layout-detection. Adding an [[example]] entry with required-features would fix it.
        """
    observed_at git:3f520cc03211e48adaa77c1da9bc639c53d2d351
    author "claude"
    created_at 2026-08-22
}

record lege-ecosystem.papercut.cargo-test-p-lege-gpu-unexpectedly-builds/1 : papercut {
    title "`cargo test -p lege-gpu` unexpectedly builds…"
    state verified
    statement """
        `cargo test -p lege-gpu` unexpectedly builds `examples/layout_compare.rs` without its required `layout-detection` feature and fails on gated imports; `cargo test -p lege-gpu --lib` is the usable default-feature library test command.
        """
    observed_at git:3f520cc03211e48adaa77c1da9bc639c53d2d351
    author "codex"
    created_at 2026-08-22
}

