record lege-ecosystem.papercut.strict-cargo-clippy-p-lege-gpu-lib-no-deps/1 : papercut {
    title "Strict `cargo clippy -p lege-gpu --lib --no-deps --features…"
    state verified
    statement """
        Strict `cargo clippy -p lege-gpu --lib --no-deps --features layout-detection -- -D warnings` cannot serve as a clean feature gate yet because the crate has 22 pre-existing Clippy findings across unrelated binarization, resize, ONNX, reference, and runtime code. The new useless-conversion finding in the changed recognition batch path was fixed.
        """
    observed_at git:7cf7bac3cee07919b12bdf545661ef7ee502bebb
    author "codex"
    created_at 2026-08-11
}

record lege-ecosystem.papercut.the-cli-help-says-a-single-page-number-such-as/1 : papercut {
    title "The CLI help says a single page number such as `5` is a valid…"
    state verified
    statement """
        The CLI help says a single page number such as `5` is a valid PAGE-RANGE form, but `lege Structures.pdf 1 ...` exits with “Page range must be in format 'start-end'”. The help and parser should agree.
        """
