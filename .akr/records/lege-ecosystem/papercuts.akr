record lege-ecosystem.papercut.building-the-focused-lege-freya-gui-emitted/1 : papercut {
    title "Building the focused Lege Freya GUI emitted over a hundred existing…"
    state verified
    statement """
        Building the focused Lege Freya GUI emitted over a hundred existing future-incompatible float-literal warnings, producing roughly 1,800 lines and obscuring the build result. Fixing or centrally suppressing the known warnings would make GUI regression builds substantially easier to audit.
        """
    observed_at git:7cf7bac3cee07919b12bdf545661ef7ee502bebb
    author "codex"
    created_at 2026-08-12
}

