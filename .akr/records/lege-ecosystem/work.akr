record lege-ecosystem.work.linux-gui-backend-fallback/1 : work {
    title "Make Linux GUI event-loop startup fall back from unavailable Wayland to X11"
    state completed
    scope [ path "freya-main/crates/freya-winit/**", path "lege-process/GUI/Freya/**" ]
    intent """
        Make Linux GUI startup select an actually usable winit backend and recover from an unavailable Wayland compositor by trying X11 when available, while preserving explicit backend choices.
        """
    claim intent {
        text """
            Linux GUI startup must choose an actually usable winit backend and recover from an unavailable Wayland compositor by trying X11 when available, while preserving explicit backend choices.
            """
    }
    acceptance {
        check backend-policy {
            statement """
                Unit tests cover automatic Wayland preference, stale-Wayland-to-X11 fallback, single advertised backend selection, and the no-backend error.
                """
            method command
            verified_by [ @lege-ecosystem.evidence.linux-gui-backend-policy-tests/1 ]
        }
        check compile {
            statement """
                The affected Freya winit crate and the Lege Freya GUI compile with the Linux backend-selection implementation.
                """
            method command
            verified_by [ @lege-ecosystem.evidence.linux-gui-freya-build/1 ]
        }
        check startup-diagnostic {
            statement """
                With a stale WAYLAND_DISPLAY and a live DISPLAY the GUI enters its event loop through X11, while exhausting both backends reports a specific diagnostic instead of the opaque winit expect.
                """
            method observation
            verified_by [ @lege-ecosystem.evidence.linux-gui-stale-wayland-fallback/1 ]
        }
    }
}

