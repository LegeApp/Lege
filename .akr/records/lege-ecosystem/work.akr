record lege-ecosystem.work.prefer-discrete-gpu/1 : work {
    title "Prefer discrete GPU for compute and presentation"
    state active
    scope [
        path "lege-gpu/src/presentation.rs",
        path "lege-gpu/src/vision/runtime/device.rs",
        path "lege-gpu/src/wgpu_setup.rs"
    ]
    intent """
        Make automatic wgpu adapter selection deterministic by trying discrete adapters before integrated, virtual, and CPU adapters for both shared compute/layout detection and surface presentation, while retaining explicit adapter overrides and graceful fallback.
        """
    acceptance {
        check compute-hardware {
            statement """
                On a host with an enumerated discrete GPU, the shared compute context selects a discrete adapter.
                """
            method command
            command "LEGE_TEST_GPU_SELECTION=1 cargo test -p lege-gpu --features layout-detection shared_context_prefers_discrete_when_available --lib -- --nocapture"
        }
        check presentation-build {
            statement """
                The presentation feature compiles after using the same ordered fallback policy.
                """
            method command
            command "cargo check -p lege-gpu --features presentation,layout-detection"
        }
        check selection-policy {
            statement """
                Unit tests prove discrete adapters rank ahead of integrated and software adapters.
                """
            method command
            command "cargo test -p lege-gpu wgpu_setup::tests --lib"
        }
    }
}

record lege-ecosystem.work.preserve-jbig2-smask-text-plane/1 : work {
    title "Preserve native JBIG2 image SMask text planes through PDF processing"
    state completed
    scope [
        path "lege-pdf/read/**",
        path "lege-pdf/render/crates/pdf-content/**",
        path "lege-pdf/render/crates/pdf-page-ir/**",
        path "lege-pdf/render/crates/pdf-render-cpu/**",
        path "lege-pdf/write/**",
        path "lege-process/core/**",
        path "lege-process/pipeline/**"
    ]
    intent """
        Add a conservative PDF-only quality-preservation path for scanned pages whose full-page image foreground carries a one-bit JBIG2 /SMask. Preserve the source JBIG2 page stream, globals, dimensions, decode polarity, and placement for output rather than re-thresholding rendered pixels. Separately decode the mask once and produce a Lanczos3-resized Gray8 ink-coverage plane for target-resolution background cleanup, OCR, layout alignment, and figure compositing; never re-encode that working plane as the authoritative text layer.
        """
    note """
        Initial scope is non-reflow PDF MRC/grayscale output. Eligibility is per page and requires an image /SMask (not /Mask, /ImageMask, page soft mask, or SMaskInData), codec JBIG2, one bit per component, intact page/global streams, binary-representable /Decode polarity, a single unambiguous axis-aligned full-page placement, scan-like image structure, and no unsupported paint whose preservation would depend on the foreground image. Mixed or ineligible pages use the existing full-render/binarize path. The native mask XObject may be scaled by PDF placement without resampling its stored pixels; rectangular crop and richer transforms are follow-ups. Reflow, deskew, DjVu, EPUB, arbitrary soft masks, multiple mask mosaics, and damaged JBIG2 are out of the first implementation.
        """
    claim authoritative-plane {
        text """
            The source JBIG2 stream and globals are the authoritative final text plane and remain byte-identical; the Lanczos3 Gray8 plane is a derived working surface only.
            """
    }
    claim first-scope-boundary {
        text """
            The first implementation targets non-reflow PDF grayscale/MRC output; transformations that require destructive mask raster rewriting remain out of scope.
            """
    }
    claim no-rethreshold {
        text """
            Eligible pages bypass scan-derived text binarization; continuous Lanczos3 coverage used by cleanup and OCR is not thresholded back into the final text layer.
            """
    }
    claim per-page-fallback {
        text """
            Failure to recognize, decode, place, or validate the preserved mask falls back per page to the existing renderer and processing pipeline without content loss.
            """
    }
    claim strict-eligibility {
        text """
            Automatic use is restricted to structurally verified one-bit JBIG2 image /SMask scan pages with representable polarity and full-page placement.
            """
    }
    acceptance {
        check eligibility-corpus {
            statement """
                Focused fixtures accept a full-page one-bit JBIG2 image /SMask with globals and reject maskless JPEG, non-JBIG2 SMask, /Mask, /ImageMask, SMaskInData, arbitrary grayscale SMask, ambiguous multiple masks, corrupt JBIG2, and unsupported placement.
                """
            method command
            verified_by [ @lege-ecosystem.evidence.preserved-jbig2-smask-focused-tests/1 ]
        }
        check lanczos-working-plane {
            statement """
                The renderer/read seam decodes only the qualifying SMask at native dimensions and produces exactly one Lanczos3-resized Gray8 ink-coverage plane at the requested output geometry without invoking scan thresholding.
                """
            method command
            verified_by [ @lege-ecosystem.evidence.preserved-jbig2-smask-focused-tests/1 ]
        }
        check mixed-page-fallback {
            statement """
                A mixed document processes eligible and ineligible pages in one run, preserving masks only where qualified and producing nonblank fallback pages elsewhere.
                """
            method command
            verified_by [ @lege-ecosystem.evidence.preserved-jbig2-mixed-page-fallback/1 ]
        }
        check payload-roundtrip {
            statement """
                For eligible fixtures, the output JBIG2 page stream and globals are byte-identical to the input SMask payloads, and output stencil polarity renders black ink exactly where the source SMask opacity is nonzero.
                """
            method command
            verified_by [
                @lege-ecosystem.evidence.structures-jbig2-payload-roundtrip-corrected/1
            ]
        }
        check pipeline-bypass {
            statement """
                Eligible PDF MRC pages use the preserved mask for cleanup, OCR input, and final text composition while bypassing binarize_image and clean-page mask derivation; detected figure crops remain composited from the normal rendered page.
                """
            method command
            verified_by [
                @lege-ecosystem.evidence.structures-layout-preserved-mask-composition/1
            ]
        }
        check quality-oracle {
            statement """
                Rendering the output at the source mask grid yields the same ink support and connected-component topology as the decoded source SMask outside explicitly overlaid figure regions.
                """
            method command
            verified_by [ @lege-ecosystem.evidence.structures-jbig2-ink-support-oracle/1 ]
        }
        check scope-guards {
            statement """
                Reflow, DjVu, EPUB, unsupported crop/deskew transforms, and non-PDF inputs cannot enter the preserved-mask path.
                """
            method command
            verified_by [ @lege-ecosystem.evidence.preserved-jbig2-scope-and-bypass-audit/1 ]
        }
    }
    source {
        kind external
        role example
        url "https://github.com/koreader/koreader-base/pull/2361"
        use """
            Demonstrates that rendering only attached image masks is practical, while this work retains the mask as an output-quality source plane.
            """
    }
    source {
        kind external
        role rationale
        url "https://github.com/koreader/koreader/issues/7992"
        use """
            Documents the Internet Archive JPX plus JBIG2 SMask scan family and the benefit of isolating its pre-existing text mask.
            """
    }
    source {
        kind internal
        role rationale
        path "lege-pdf/render/crates/pdf-content/src/interpret.rs"
        use """
            The interpreter deliberately preserves codec-encoded JBIG2 SMask data instead of decoding it.
            """
    }
    source {
        kind internal
        role rationale
        path "lege-pdf/render/crates/pdf-page-ir/src/lib.rs"
        use """
            ImageSMask already retains native dimensions, decode metadata, codec identity, encoded payload, globals and codec parameters.
            """
    }
    source {
        kind internal
        role rationale
        path "lege-pdf/write/src/images.rs"
        use """
            The writer already emits JBIG2 streams with optional globals and ImageMask semantics but needs preserved polarity metadata.
            """
    }
    source {
        kind internal
        role rationale
        path "lege-process/pipeline/pdf_tokio_pipeline.rs"
        use """
            The current MRC path derives a new mask from rendered pixels and then composes a JP2 background with a JBIG2 mask.
            """
    }
}

