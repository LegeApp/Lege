record lege-ecosystem.work.fold-automatic-toc-into-ocr/1 : work {
    title "Fold automatic table of contents into the GUI OCR feature"
    state superseded
    scope [
        path "lege-process/GUI/Freya/src/**",
        path "lege-process/language_service/*/gui_text.json"
    ]
