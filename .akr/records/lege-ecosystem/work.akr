record lege-ecosystem.work.embed-freya-about-documents/1 : work {
    title "Embed Freya About documents and separate GUI build aliases"
    state completed
    scope [
        path ".cargo/config.toml",
        path "lege-misc/docs/documentation.html",
        path "lege-misc/docs/licenses.html",
        path "lege-process/GUI/Freya/src/app.rs",
        path "lege-process/GUI/Freya/src/backend.rs",
        path "lege-process/core/main.rs"
    ]
    intent """
        Make Freya About documentation and license actions independent of release-folder copies, keep one compile-time source of truth, and make cargo gui build Freya while cargo viewer-gui builds the native viewer.
        """
    note """
        The pre-change project, Linux staging, and MSIX documentation files were byte-identical and included Reflow. The project license page was newer than staging and became the canonical audited source.
        """
    claim build-aliases {
        text """
            cargo gui builds the Lege worker and integrated Freya GUI; cargo viewer-gui builds the separate native viewer.
            """
    }
    claim current-notices {
        text """
            The focused license notice names default PP-OCRv5/wgpu and current codecs while removing unused ort/lopdf and describing Tesseract as optional legacy functionality.
            """
    }
    claim embedded-about {
        text """
            Freya embeds documentation.html, licenses.html, and the full AGPL text at compile time, materializing only disposable cache files for the system browser.
            """
    }
    claim opener-errors {
        text """
            About buttons close only after a successful system opener result and otherwise show the actual error.
            """
    }
    acceptance {
        check document-audit {
            statement """
                Before editing, project/Linux/MSIX documentation copies had identical SHA-256 c78277275d80915433e541dc2e712d18281dd19c7a855b66e0145929d84c9e5a and included the Reflow section.
                """
            method observation
            verified_by [ @lege-ecosystem.evidence.release-document-copy-audit/1 ]
        }
        check embedded-output {
            statement """
                Built artifacts contain the canonical documents and the CLI prints the embedded updated notice.
                """
            method command
            command "strings target/debug/lege-gui | rg -m 2 'Margin Correction and Reflow|Lege License and Third-Party Notices'; target/debug/lege --licenses | rg 'PaddleOCR / PP-OCRv5'"
            verified_by [ @lege-ecosystem.evidence.embedded-about-built-output/1 ]
        }
        check freya-tests {
            statement """
                The complete Freya suite passes, including embedded-content and stale-cache refresh tests.
                """
            method command
            command "cargo test -p lege-gui-freya"
            verified_by [ @lege-ecosystem.evidence.freya-embedded-about-tests/1 ]
        }
        check gui-builds {
            statement """
                Both requested GUI build aliases complete successfully and select their intended applications.
                """
            method command
            command "cargo gui && cargo viewer-gui"
            verified_by [ @lege-ecosystem.evidence.freya-viewer-build-aliases/1 ]
        }
    }
}

record lege-ecosystem.work.end-to-end-oracle-whole-page-vs-pdfium/1 : work {
    title "End-to-end oracle (whole page vs PDFium)"
    state proposed
    intent """
        `pdf-renderer/tools/pdfium-diff` (a separate crate, needs `libpdfium`;
        `D:\Rust-projects\pdfium-port-plan\pdfium.dll` is present):
        ```bash
        cd tools/pdfium-diff
        cargo run -- D:/Rust-projects/pdfium-port-plan/pdfium.dll 2.0 "<one-file.pdf>"
        # writes pdfium-diff-out/results.csv; summary line prints suspect/silent-blanks/degraded.
        ```
        Use this to confirm a decode fix actually clears the page against PDFium. **Do
        not run the full corpus sweep** (11k files, ~2 h) — the owner runs that; single
        files are seconds.
        """
    source {
        kind legacy
        path "lege-codecs/jp2lam/decode-fix-plan/HANDOFF-remaining-jpx-decode.md"
        excerpt """
            `pdf-renderer/tools/pdfium-diff` (a separate crate, needs `libpdfium`;
            `D:\Rust-projects\pdfium-port-plan\pdfium.dll` is present):
            ```bash
            cd tools/pdfium-diff
            cargo run -- D:/Rust-projects/pdfium-port-plan/pdfium.dll 2.0 "<one-file.pdf>"
            # writes pdfium-diff-out/results.csv; summary line prints suspect/silent-blanks/degraded.
            ```
            Use this to confirm a decode fix actually clears the page against PDFium. **Do
            not run the full corpus sweep** (11k files, ~2 h) — the owner runs that; single
            files are seconds.
            """
    }
}

