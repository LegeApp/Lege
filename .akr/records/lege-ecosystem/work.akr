record lege-ecosystem.encode-quality.improve-photographic-rate-control/1 : work {
    title "Rework jp2lam lossy rate control for perceptual, resolution-stable photographic quality"
    state proposed
    scope [
        path "lege-codecs/jp2lam/src/decode/mod.rs",
        path "lege-codecs/jp2lam/src/dwt/pcrd.rs",
        path "lege-codecs/jp2lam/src/encode/**",
        path "lege-codecs/jp2lam/src/plan/**"
    ]
    intent """
        Raise jp2lam lossy photographic quality-per-byte toward JPEG XL/BPG and make a fixed quality hold constant PERCEPTUAL quality across resolutions. Work the causes in lege-ecosystem.encode-quality.root-cause: replace MSE-only, size-matched, single-image-calibrated rate control with perceptually weighted, butteraugli-anchored, cross-resolution-validated rate control, and connect the existing but disabled perceptual model. Grade every change with butteraugli + ssimulacra2 against a libjxl reference, not by file size.
        """
    note """
        Key code sites: quality->lambda in src/dwt/pcrd.rs quality_to_lambda (resolution_factor ^0.35 term) and select_for_quality; active RD curve build in src/encode/backend/native/rate.rs (raw_records_for_passes uses pass.mse_numerator; curves_from_tier1_layout drops contrast_mask/taubman_weights); quantization step scaling in src/plan/derive.rs (apply_quality_step_scaling, quality_step_scaler); the disabled perceptual model in src/perceptual/ and pcrd.rs (apply_contrast_masking_to_delta, band_distortion_bias, Taubman2000). rate.rs notes the perceptual delta-MSE path (P1.3) was rolled back pending lambda recalibration. A ready-made external grading harness exists at /mnt/Samsung980_1TB/Rust-projects/codec-headsup (butteraugli + ssimulacra2, libjxl FFI).
        """
    acceptance {
        check butteraugli-anchored-quality-mode {
            statement """
                Evaluate (accept or reject with evidence) a RateControl mode that targets a butteraugli distance like cjxl -d, via a size/lambda search, so callers can request a perceptual quality directly instead of a compression heuristic.
                """
            method manual
        }
        check decode-memory-scaling {
            statement """
                Default DecodeLimits (max_working_bytes 1 GiB, max_pixels 100M) are raised or made resolution-aware so a ~50MP JP2 decodes within limits by default (observed failure at ~3.0 GB estimated working set).
                """
            method manual
        }
        check no-quality-regression-gate {
            statement """
                A perceptual regression check on the corpus (butteraugli/ssimulacra2 vs the libjxl reference and vs the previous jp2lam revision) is defined and passes, so future changes cannot silently regress photographic quality.
                """
            method manual
        }
        check perceptual-grading-harness {
            statement """
                A repeatable grading step reports butteraugli AND ssimulacra2 for jp2lam vs a libjxl reference on a multi-resolution photographic corpus (>=20 images spanning ~12MP and ~50MP), so rate-control changes are judged perceptually rather than by file size.
                """
            method manual
        }
        check perceptual-weighting-wired {
            statement """
                The active PCRD selection consumes perceptual weighting (re-enable the rolled-back path: contrast/Taubman masking + subband band bias, or an equivalent CSF visual-frequency weighting), with lambda recalibrated, and shows a butteraugli/ssimulacra2 win over the MSE-only baseline at equal size on the corpus.
                """
            method manual
        }
        check photographic-lambda-recalibration {
            statement """
                quality->lambda and quality->step are recalibrated against butteraugli on the multi-image photographic corpus (not lear.png alone / not document pages), so quality is a monotone butteraugli target rather than a reproduction of prior file sizes.
                """
            method manual
        }
        check resolution-stable-quality {
            statement """
                At a fixed jp2lam quality the mean butteraugli gap between the ~12MP and ~50MP subsets is <= 0.5 (currently ~2 vs ~5-10 at q98), achieved by re-deriving or removing the quality_to_lambda resolution_factor and validating on both subsets.
                """
            method manual
        }
    }
    derived_from [ @lege-ecosystem.encode-quality.root-cause/1 ]
}

record lege-ecosystem.lege-process.about-gpu-init-2026-08-09/1 : work {
    title "Remove About email row and reduce Lege GPU initialization overhead"
    state superseded
    scope [
        path "lege-gpu/src/vision/runtime/device.rs",
        path "lege-process/GUI/Freya/src/**",
        path "lege-process/language_service/**/gui_text.json"
    ]
    intent "Remove the email line from the Freya About popup without residual layout space and evaluate GPU startup for measurable redundant initialization work, preserving adapter fallback and eager readiness semantics."
