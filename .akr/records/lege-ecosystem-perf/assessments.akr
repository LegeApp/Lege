akr 0.1
project lege-ecosystem

record lege-ecosystem-perf.assessment.fused-pack-simd-neutral/1 : assessment {
    title "Fused-pack SIMD is performance-neutral (memory/codegen-bound)"
    state verified
    statement """
        Hypothesis from the 2026-08-06 decode flamegraph: the ~15% of cycles in
        the scalar fused pack (finalize_centered_f32_u8 + <f32>::clamp +
        ict_rgb_f32 + store_rgb_layout inside fuse_pack_f32_into) could be cut
        with an 8-wide wide::f32x8 finalize/ICT. Implemented a bit-exact
        f32x8 path for the tight parallel branch (output hash unchanged at
        c1698aa01d9a325e; 339 lib tests pass). Interleaved A/B on lear q75 RGB
        (4 P-core workers, two prebuilt binaries alternated to cancel thermal
        drift) showed no difference: baseline 278.3-281.4 ms vs SIMD
        278.5-281.3 ms. The "after" flamegraph cycle shares for finalize/clamp
        were unchanged, indicating LLVM already auto-vectorizes the scalar
        per-pixel loop under fat LTO, and the pack is memory-bandwidth-bound
        (reads 3x ~37 MP f32 planes, writes ~37 MP x3 bytes). The change was
        reverted as neutral-but-more-complex. Transferable lesson (from
        jpegXL-rs): do layout/memory-traffic work before ISA SIMD; SIMD only
        accelerates arithmetic between large allocations and copies.
        Next real targets by the flamegraph: 9/7 inverse DWT vertical memory
        traffic (apply_lift_wide 14% + band gather/scatter memcpy) and Tier-1
        MQ/flag hot loop, not the pack arithmetic.
        """
    confidence high
}

record lege-ecosystem-perf.assessment.renderer-jp2-memory-audit-2026-08-25/1 : assessment {
    title "Renderer and jp2lam memory-efficiency audit, 2026-08-25"
    state verified
    scope [ path "lege-codecs/jp2lam/**", path "lege-pdf/render/**" ]
    statement """
        A static audit found hard-bound and concurrency defects in renderer image caching, unbudgeted decode memory, redundant full-buffer ownership conversions, and three JP2 structural allocation paths capable of materially exceeding current working-memory expectations.
        """
    claim codec-stream-payload-copies {
        text """
            Codec-first PDF stream compilation materializes the payload as Vec<u8> and then converts it to Arc<[u8]>, causing a second full-payload allocation and copy before decoding.
            """
    }
    claim codestream-structural-metadata {
        text """
            JP2 codestream parsing retains uncapped marker and tile-part framing vectors before semantic resource validation, allowing compact hostile input to amplify structural metadata allocations.
            """
    }
    claim decoded-image-cache-bound {
        text """
            The renderer decoded-image cache is not a hard 96 MiB bound: eviction retains one oversized entry per shard, alpha storage is omitted from the charge, and concurrent misses for one key are not coalesced.
            """
    }
    claim narrow-irreversible-scratch {
        text """
            The 9/7 vertical band scratch allocates 128 columns even when the active component is narrower, allowing a one-column image to allocate 128 times the necessary band scratch and exceed the coarse working-memory estimate.
            """
    }
    claim nested-codec-pools {
        text """
            Per-render-thread JP2 sessions retain separate dynamically resized Rayon pools; under concurrent rendering this can oversubscribe threads and multiply thread stacks and worker scratch.
            """
    }
    claim palette-allocation-amplification {
        text """
            JP2 palette parsing allocates all PCLR columns and deep-clones each CMAP-selected column before output-channel validation, allowing repeated mappings to amplify memory and causing ordinary packed palette decode to retain avoidable full i32 planes.
            """
    }
    claim renderer-vec-to-arc-conversions {
        text """
            Several large renderer conversion paths, including JPX alpha splitting and native-planar fallback, fill Vec<u8> and then convert to Arc<[u8]>, causing avoidable full-output copies and higher transient peaks.
            """
    }
    claim scheduler-decode-accounting {
        text """
            Renderer scheduler admission accounts for the page surface and transparency-group estimate but not decoded image payloads or JP2 working planes, so concurrent cold image pages can multiply unbudgeted memory.
            """
    }
    author "GitHub Uploader"
}
