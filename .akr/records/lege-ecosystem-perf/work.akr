record lege-ecosystem-perf.work.common-output-format-fallback/1 : work {
    title "4.4 Common output-format fallback"
    state proposed
    intent """
        `decode_packed_direct()` accepts only exact Gray, sRGB, or CMYK matches (`src/decode/mod.rs:515–523`). More importantly, `Rgba8` without an encoded alpha component returns `None` (`lines 524–529`), causing a full planar decode followed by generic packing.
        """
    source {
        kind legacy
        path "lege-codecs/jp2lam/decode-fix-plan/jp2lam-decoder-performance-audit-2026-08-05.md"
        excerpt """
            `decode_packed_direct()` accepts only exact Gray, sRGB, or CMYK matches (`src/decode/mod.rs:515–523`). More importantly, `Rgba8` without an encoded alpha component returns `None` (`lines 524–529`), causing a full planar decode followed by generic packing.
            """
    }
}

