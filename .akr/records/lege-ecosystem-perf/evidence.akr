record lege-ecosystem-perf.evidence.jpeg-sweep-final-buffer-profile/1 : evidence {
    title "JPEG Sweep output-copy removal profile"
    state superseded
    result pass
    method command
    observed_at git:ef8b70669f02df887a959aafe62ac996691c9ef3
    command "lege-pdf/render/tools/pdfium-diff/target/release/pdfium-diff profile 2.0833333 /mnt/Samsung980_1TB/to-sort/globalhistoryofm0000unse_1.pdf 0 11 .agent/scratch/mrc-smask-followup-20260809/jpeg-sweep.final2.compiled.jsonl --mode compiled"
    artifact "lege-pdf/render/crates/pdf-render-cpu/src/lib.rs"
    summary """
        The final 11-run JPEG Sweep compiled-page median was 95.828 ms versus the 7-run 161.684 ms baseline (-40.7%); render.output fell from 63.884 ms to 0.000270 ms, peak live renderer bytes halved, and output hash 3dfafb56edf8d303 was unchanged.
        """
}

