record lege-ecosystem-perf.evidence.structures-smask-followup-profile/1 : evidence {
    title "Structures.pdf soft-mask renderer and decoder follow-up profile"
    state superseded
    result pass
    method command
    observed_at git:ef8b70669f02df887a959aafe62ac996691c9ef3
    command "lege-pdf/render/tools/pdfium-diff/target/release/pdfium-diff profile 2.0833333 /home/dk/Desktop/Structures.pdf 0 11 .agent/scratch/mrc-smask-followup-20260809/structures.final.compiled.jsonl --mode compiled && lege-pdf/render/tools/pdfium-diff/target/release/pdfium-diff profile 2.0833333 /home/dk/Desktop/Structures.pdf 0 11 .agent/scratch/mrc-smask-followup-20260809/structures.final.warm-decoded.jsonl --mode warm-decoded && lege-pdf/render/tools/pdfium-diff/target/release/pdfium-diff profile 2.0833333 /home/dk/Desktop/Structures.pdf 0 11 .agent/scratch/mrc-smask-followup-20260809/structures.final.decode-only.jsonl --mode decode-only"
    summary """
        On the supplied Structures.pdf page 0 at scale 2.0833333 (926x1330 output; 2222x3191 JPX sources), 11-run medians were 71.028 ms compiled and 70.449 ms warm-decoded with hash fdc3994f80330ee0; render.output was approximately 0.00017 ms. Decode-only was 237.823 ms: 196.440 ms JPX plus 41.367 ms JBIG2, confirming cold decode remains outside the renderer-side fast path.
        """
}

