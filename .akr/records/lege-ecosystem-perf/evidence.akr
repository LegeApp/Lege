record lege-ecosystem-perf.evidence.structures-direct-vs-owned-output-2026-08-09/1 : evidence {
    title "Structures.pdf direct Arc output versus owned Vec control"
    state superseded
    result pass
    method observation
    observed_at git:174105ceac73d00a20e25fc7bf80d23444dd7d93
    artifact ".agent/scratch/mrc-smask-followup-20260809/structures.owned-control.decode-only.jsonl"
    summary """
        A 21-run control build temporarily forcing the former owned-raster plus Vec-to-Arc path measured 266.771 ms median JPX (p25/p75 261.850/282.075), versus 204.616 ms (195.466/233.428) for direct Arc output: direct output was 23.3% faster in this same-session A/B. Both hashes were fdc3994f80330ee0; the direct gate was restored after measurement.
        """
}

record lege-ecosystem-perf.evidence.structures-direct-vs-owned-output-2026-08-09/2 : evidence {
    title "Structures.pdf direct Arc output versus owned Vec control"
    state verified
    result pass
    method observation
    observed_at git:174105ceac73d00a20e25fc7bf80d23444dd7d93
    artifact ".agent/scratch/mrc-smask-followup-20260809/structures.packed-owned-control.decode-only.jsonl"
    summary "A corrected 21-run control temporarily restored the former packed owned-raster plus Vec-to-Arc path. It measured 196.892 ms median JPX (p25/p75 192.961/205.569), versus 204.616 ms (195.466/233.428) for direct Arc output in a sequential same-session comparison. Direct output was about 3.9% slower at the median, and the distributions overlap, so this run demonstrates no throughput improvement. Both output hashes were fdc3994f80330ee0. The direct path still removes one full-image allocation and copy; the temporary control branch was removed after measurement. Revision 1 used the native-planar fallback as its control and is superseded by this corrected packed-path measurement."
    supersedes [ @lege-ecosystem-perf.evidence.structures-direct-vs-owned-output-2026-08-09/1 ]
}

record lege-ecosystem-perf.evidence.structures-smask-followup-profile/1 : evidence {
    title "Structures.pdf soft-mask renderer and decoder follow-up profile"
    state superseded
    result pass
    method command
    observed_at git:ef8b70669f02df887a959aafe62ac996691c9ef3
    command "lege-pdf/render/tools/pdfium-diff/target/release/pdfium-diff profile 2.0833333 /home/dk/Desktop/Structures.pdf 0 11 .agent/scratch/mrc-smask-followup-20260809/structures.final.compiled.jsonl --mode compiled && lege-pdf/render/tools/pdfium-diff/target/release/pdfium-diff profile 2.0833333 /home/dk/Desktop/Structures.pdf 0 11 .agent/scratch/mrc-smask-followup-20260809/structures.final.warm-decoded.jsonl --mode warm-decoded && lege-pdf/render/tools/pdfium-diff/target/release/pdfium-diff profile 2.0833333 /home/dk/Desktop/Structures.pdf 0 11 .agent/scratch/mrc-smask-followup-20260809/structures.final.decode-only.jsonl --mode decode-only"
    summary """
        On the supplied Structures.pdf page 0 at scale 2.0833333 (926x1330 output; 2222x3191 JPX sources), 11-run medians were 71.028 ms compiled and 70.449 ms warm-decoded with hash fdc3994f80330ee0; render.output was approximately 0.00017 ms. Decode-only was 237.823 ms: 196.440 ms JPX plus 41.367 ms JBIG2, confirming cold decode remains outside the renderer-side fast path.
        """
}

