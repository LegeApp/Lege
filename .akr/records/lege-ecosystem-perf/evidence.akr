record lege-ecosystem-perf.evidence.jp2-direct-output-benchmark-smoke-2026-08-09/1 : evidence {
    title "Direct-output release benchmark smoke"
    state verified
    result pass
    method command
    observed_at git:174105ceac73d00a20e25fc7bf80d23444dd7d93
    command "JP2LAM_DECODE_BENCH_WIDTH=512 JP2LAM_DECODE_BENCH_HEIGHT=512 JP2LAM_DECODE_BENCH_ITERS=5 JP2LAM_DECODE_BENCH_THREADS=4 cargo run --release --manifest-path lege-codecs/jp2lam/Cargo.toml --example decode_benchmark"
    artifact "lege-codecs/jp2lam/examples/decode_benchmark.rs"
    summary """
        The release benchmark exercised path=session_packed_into and produced stable output hash 08ffafc12705f1c4 at 2.993 ms median for the synthetic 512x512 Gray8 fixture.
        """
}

