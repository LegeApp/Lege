record lege-ecosystem-perf.evidence.jpeg-direct-arc-decode-profile/1 : evidence {
    title "JPEG direct-Arc decoder assembly profile"
    state superseded
    result pass
    method command
    observed_at git:ef8b70669f02df887a959aafe62ac996691c9ef3
    command "lege-pdf/render/tools/pdfium-diff/target/release/pdfium-diff profile 2.0833333 /mnt/Samsung980_1TB/to-sort/globalhistoryofm0000unse_1.pdf 0 15 .agent/scratch/mrc-smask-followup-20260809/jpeg-decode.final2.jsonl --mode decode-only"
    artifact "lege-pdf/render/crates/pdf-image/src/jpeg/mod.rs"
    summary """
        The representative JPEG decode-only median fell from 81.430 ms to 63.842 ms (-21.6%) after assembly moved from Vec-to-Arc copy to direct Arc output, with output hash 3dfafb56edf8d303 unchanged.
        """
}

