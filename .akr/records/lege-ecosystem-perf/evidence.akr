record lege-ecosystem-perf.evidence.mrc-smask-final-buffer-regression-suite/1 : evidence {
    title "Renderer, codec, scheduler, postprocess, and chaos regression suite passes"
    state superseded
    result pass
    method command
    observed_at git:ef8b70669f02df887a959aafe62ac996691c9ef3
    command "cd lege-pdf && cargo test -q -p pdf-render-cpu -p pdf-image -p pdf-content -p pdf-render-scheduler -p pdf-postprocess -p pdf-chaos-tests"
    artifact "lege-pdf/render/crates/pdf-render-cpu/src/surface.rs"
    summary """
        The full targeted renderer/codec test set passed after the Arc final-buffer handoff, including pixel-equivalence, fixture, and chaos coverage; focused RGB8 area-min mask tests also passed 6/6.
        """
}

