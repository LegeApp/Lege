akr 0.1
project lege-ecosystem

record lege-ecosystem-perf.policy.gpu-path-useful-but-only-with-renderer/1 : policy {
    title "13. GPU path: useful, but only with renderer integration"
    state proposed
    scope [ all ]
    rule """
        NVIDIA’s current nvJPEG2000 library offloads every decode stage except Tier-2 to Pascal-or-newer GPUs, supports 5/3 and 9/7, multiple tiles, up to four components, common chroma subsampling, resolution/tile decode, partial decode, RGB output controls, and reusable decode state. On an RTX 4060, it is a viable experimental control or optional backend.
        """
    source {
        kind legacy
        path "lege-codecs/jp2lam/decode-fix-plan/jp2lam-decoder-performance-audit-2026-08-05.md"
        excerpt """
            NVIDIA’s current nvJPEG2000 library offloads every decode stage except Tier-2 to Pascal-or-newer GPUs, supports 5/3 and 9/7, multiple tiles, up to four components, common chroma subsampling, resolution/tile decode, partial decode, RGB output controls, and reusable decode state. On an RTX 4060, it is a viable experimental control or optional backend.
            """
    }
}

record lege-ecosystem-perf.policy.parallelism-policy-for-a-pdf-renderer/1 : policy {
    title "11. Parallelism policy for a PDF renderer"
    state proposed
    scope [ all ]
    rule """
        The decoder cannot choose thread count in isolation. The renderer already runs pages/images concurrently. Nested unrestricted Rayon work can reduce document throughput and increase tail latency.
        """
    source {
        kind legacy
        path "lege-codecs/jp2lam/decode-fix-plan/jp2lam-decoder-performance-audit-2026-08-05.md"
        excerpt """
            The decoder cannot choose thread count in isolation. The renderer already runs pages/images concurrently. Nested unrestricted Rayon work can reduce document throughput and increase tail latency.
            """
    }
}

record lege-ecosystem-perf.policy.phase-5-true-windowed-line-based-decode/1 : policy {
    title "Phase 5 — true windowed/line-based decode"
    state proposed
    scope [ all ]
    rule """
        1. Windowed subband allocation.
        2. Row- and column-limited IDWT.
        3. Strip/row callback finalization into the renderer or GPU upload.
        4. Parsed-plan cache.
        5. ROI coverage threshold policy.
        """
    source {
        kind legacy
        path "lege-codecs/jp2lam/decode-fix-plan/jp2lam-decoder-performance-audit-2026-08-05.md"
        excerpt """
            1. Windowed subband allocation.
            2. Row- and column-limited IDWT.
            3. Strip/row callback finalization into the renderer or GPU upload.
            4. Parsed-plan cache.
            5. ROI coverage threshold policy.
            """
    }
}

