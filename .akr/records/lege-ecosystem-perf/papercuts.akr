akr 0.1
project lege-ecosystem

record lege-ecosystem-perf.papercut.a-release-profiler-rebuild-from-the-repository/1 : papercut {
    title "A release-profiler rebuild from the repository root rejected…"
    state verified
    statement """
        A release-profiler rebuild from the repository root rejected `--features bench-profiling` because the `pdfium-diff` tool is deliberately outside the workspace; the feature belongs to its own manifest. The command must run from `lege-pdf/render/tools/pdfium-diff` or pass that manifest explicitly.
        """
    observed_at git:ef8b70669f02df887a959aafe62ac996691c9ef3
    author "codex"
    created_at 2026-08-09
}

record lege-ecosystem-perf.papercut.after-committing-validated-akr-record-changes/1 : papercut {
    title "After committing validated AKR record changes with ordinary Git, `akr…"
    state superseded
    statement """
        After committing validated AKR record changes with ordinary Git, `akr lock --check` rejected the embedded build commit because the lock was generated against the parent source commit. The workflow needs an atomic documented commit path or an explicit follow-up lock-only commit; otherwise a seemingly clean knowledge commit fails the required post-commit audit.
        """
    observed_at git:c0baea0d7c8b7d17690c6da78db22e407e82cf5d
    about "akr"
    author "codex"
    created_at 2026-08-09
}

