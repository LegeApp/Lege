diff --git a/hayro/examples/render.rs b/hayro/examples/render.rs
--- a/hayro/examples/render.rs
+++ b/hayro/examples/render.rs
@@ -27,6 +27,12 @@ fn main() {
         .nth(3)
         .and_then(|s| s.parse::<f32>().ok())
