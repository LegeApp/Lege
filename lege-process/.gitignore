# Cargo aliases live in .cargo/config.toml.
# Put machine-specific overrides in environment variables instead of committing
# local paths.

# Rust
target/
**/*.rs.bk
Cargo.lock

# OS-specific
.DS_Store
Thumbs.db

# Binary artifacts
*.so
*.a
*.dll
*.exe
*.bin
*.o
*.d

# Logs
*.log

# Misc
*.zip
*.tar.gz
.idea/
.vscode/
.codegraph/

# Dev / large binary files
*.pdf
*.onnx
*.pt
*.pth
*.safetensors
*.gguf
*.weights
*.npz
*.npy
model_weights/
models/

# .NET/VS
bin/
obj/
*.user
*.suo
*.userprefs
*.rsuser
*.cache
*.ide
*.nupkg
*.snupkg
/*.vs/
**/*.wpftmp.csproj
**/*_wpftmp.csproj
test-outputs/

# Embedded layout and Sauvola models — required build assets (compiled in via
# include_bytes!). Un-ignore them over the *.onnx and models/ rules above.
!models/
!models/doclayout.onnx
!models/sauvola.onnx

# Embedded PP-OCR det/rec models (fp16) + dictionary — required build assets,
# compiled into lege-ocr via include_bytes!. Override the *.onnx rule above.
!lege-ocr/assets/
!lege-ocr/assets/ppocr-det.onnx
!lege-ocr/assets/ppocr-rec.onnx

# Local scratch / tooling not for the repo
grayscale-tester-area/
cargo-checker
.claude/
